# URL interna de la API NestJS (la usa Next del lado del servidor y para reescribir /api y /uploads)
API_URL=http://localhost:4000
# URL pública del sitio (SEO, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secreto compartido con la API para refrescar la caché al guardar en el panel (npm run env lo completa)
REVALIDATE_SECRET=se-genera-con-npm-run-env
