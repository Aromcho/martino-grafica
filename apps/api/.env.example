# Base de datos (docker compose levanta Postgres en el puerto 5433)
DATABASE_URL="postgresql://martino:martino@localhost:5433/martino"

# Servidor
PORT=4000
# En producción: 127.0.0.1 (sólo accesible desde Nginx)
HOST=0.0.0.0
NODE_ENV=development
# Orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000
# URL pública del sitio (links de WhatsApp, avisos al sitio para refrescar caché)
PUBLIC_SITE_URL=http://localhost:3000
# URL interna del sitio Next para avisar cambios (revalidación por tags)
WEB_INTERNAL_URL=http://localhost:3000
REVALIDATE_SECRET=se-genera-con-npm-run-env

# Autenticación del panel (npm run env genera un secreto aleatorio)
JWT_SECRET=se-genera-con-npm-run-env
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Usuario administrador inicial (lo crea el seed; cambiá la contraseña al entrar)
ADMIN_EMAIL=admin@martinografica.com.ar
ADMIN_PASSWORD=se-genera-con-npm-run-env
ADMIN_NAME="Emmanuel Martino"

# Archivos: imágenes públicas (uploads) y archivos de clientes adjuntos a presupuestos (private, no públicos)
UPLOADS_DIR=./uploads
PRIVATE_DIR=./private
# Tamaño máximo por archivo de diseño adjunto (MB)
QUOTE_FILE_MAX_MB=25
